#!/usr/bin/python
# restarts the device on a schedule, with a different time for each weekday,
# and on demand through the "restart now" switch.
# runs on the python 2.7 found on info-beamer os (and on python 3 too).
# reads config.json from the package directory on every loop, so config
# changes made in the info-beamer ui apply without restarting the service.

import json
import os
import subprocess
import sys
import time

days = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]

# never restart on a schedule or request if the device booted less than this
# many seconds ago. this prevents reboot loops when the clock is wrong right
# after boot.
min_uptime = 600

# the timezone currently applied to this process
current_tz = [None]


def log(msg):
    print("[restart] " + msg)
    sys.stdout.flush()


def uptime():
    try:
        with open("/proc/uptime") as f:
            return float(f.read().split()[0])
    except Exception:
        return 0.0


def load_config():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.json")
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def apply_timezone(cfg):
    # info-beamer passes the timezone of the device in the config metadata.
    # use it for local time. if it cannot be applied, the system zone is used.
    name = cfg.get("__metadata", {}).get("timezone")
    if not name or name == current_tz[0]:
        return
    try:
        os.environ["TZ"] = str(name)
        time.tzset()
        current_tz[0] = name
        log("timezone set to %s (%s)" % (name, time.tzname[0]))
    except Exception as e:
        current_tz[0] = name
        log("could not set timezone %s: %s" % (name, e))


def parse_time(value):
    # turns "hh:mm" into (hour, minute). empty or invalid means no restart.
    try:
        hour, minute = ("%s" % value).strip().split(":")
        hour, minute = int(hour), int(minute)
    except Exception:
        return None
    if 0 <= hour <= 23 and 0 <= minute <= 59:
        return (hour, minute)
    return None


def run(cmd):
    try:
        code = subprocess.call(cmd)
        log("%s exited with %d" % (" ".join(cmd), code))
        return code == 0
    except OSError as e:
        log("%s failed: %s" % (" ".join(cmd), e))
        return False


def reboot():
    # try several ways, as the available command depends on the os setup.
    run(["sync"])
    log("running as uid %d" % os.getuid())
    for cmd in (["/sbin/reboot"], ["reboot"], ["/sbin/reboot", "-f"]):
        if run(cmd):
            return True
    # last resort: ask the kernel directly
    try:
        with open("/proc/sys/kernel/sysrq", "w") as f:
            f.write("1")
        with open("/proc/sysrq-trigger", "w") as f:
            f.write("b")
        return True
    except Exception as e:
        log("sysrq reboot failed: %s" % e)
    log("could not reboot the device")
    return False


def main():
    last_run = None  # day of the last scheduled restart, so we fire once a day
    # the manual switch is acted on when it changes from off to on while the
    # service runs. if it is already on at startup, it counts as a request only
    # when the device has been up for a while. this covers the service being
    # restarted by a config change, and a reboot never repeats itself because
    # the uptime is low right after booting.
    cfg = load_config()
    apply_timezone(cfg)
    log("service started, config: %s" % json.dumps(cfg))
    last_manual = bool(cfg.get("restart_now", False))
    if last_manual and uptime() >= min_uptime:
        log("manual restart requested (switch was already on)")
        reboot()
    while True:
        cfg = load_config()
        apply_timezone(cfg)
        manual = bool(cfg.get("restart_now", False))
        if manual and not last_manual:
            log("manual restart requested")
            last_manual = manual
            reboot()
        last_manual = manual

        now = time.localtime()
        when = parse_time(cfg.get("time_" + days[now.tm_wday], "04:00"))
        today = (now.tm_year, now.tm_yday)
        if when is not None and (now.tm_hour, now.tm_min) == when and last_run != today:
            last_run = today
            if uptime() < min_uptime:
                log("skipping restart, device booted recently")
            else:
                log("scheduled restart now")
                reboot()
        time.sleep(10)


if __name__ == "__main__":
    main()
