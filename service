#!/usr/bin/python3
# restarts the device once a day at a configured time on selected weekdays.
# reads config.json from the package directory on every loop, so config
# changes made in the info-beamer ui apply without restarting the service.

import json
import os
import subprocess
import sys
import time
from datetime import datetime

days = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]

# never restart if the device booted less than this many seconds ago. this
# prevents reboot loops when the clock is wrong right after boot.
min_uptime = 600


def log(msg):
    print("[restart] " + msg)
    sys.stdout.flush()


def uptime():
    try:
        with open("/proc/uptime") as f:
            return float(f.read().split()[0])
    except Exception:
        return 0.0


def load_config():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.json")
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def reboot():
    # try several ways, as the available command depends on the os setup.
    try:
        os.sync()
    except Exception:
        pass
    log("running as uid %d" % os.getuid())
    for cmd in (["/sbin/reboot"], ["reboot"], ["systemctl", "reboot"], ["/sbin/reboot", "-f"]):
        try:
            code = subprocess.call(cmd)
            log("%s exited with %d" % (" ".join(cmd), code))
            if code == 0:
                return True
        except OSError as e:
            log("%s failed: %s" % (" ".join(cmd), e))
    # last resort: ask the kernel directly
    try:
        with open("/proc/sys/kernel/sysrq", "w") as f:
            f.write("1")
        with open("/proc/sysrq-trigger", "w") as f:
            f.write("b")
        return True
    except Exception as e:
        log("sysrq reboot failed: %s" % e)
    log("could not reboot the device")
    return False


def main():
    last_run = None  # date of the last attempt, so we fire once per day
    # the manual switch is acted on when it changes from off to on while the
    # service runs. if it is already on at startup, it counts as a request only
    # when the device has been up for a while. this covers the service being
    # restarted by a config change, and a reboot never repeats itself because
    # the uptime is low right after booting.
    cfg = load_config()
    log("service started, config: %s" % json.dumps(cfg))
    last_manual = bool(cfg.get("restart_now", False))
    if last_manual and uptime() >= min_uptime:
        log("manual restart requested (switch was already on)")
        reboot()
    while True:
        cfg = load_config()
        manual = bool(cfg.get("restart_now", False))
        if manual and not last_manual:
            log("manual restart requested")
            last_manual = manual
            reboot()
        last_manual = manual
        now = datetime.now()
        try:
            hour = int(cfg.get("hour", 4))
            minute = int(cfg.get("minute", 0))
        except (TypeError, ValueError):
            hour, minute = 4, 0
        day_enabled = cfg.get(days[now.weekday()], True)

        due = (now.hour, now.minute) == (hour, minute)
        if due and day_enabled and last_run != now.date():
            last_run = now.date()
            if uptime() < min_uptime:
                log("skipping restart, device booted recently")
            else:
                log("restarting now")
                reboot()
        time.sleep(10)


if __name__ == "__main__":
    main()
