{
  "name": "scheduled restart",
  "permissions": {
    "run-as-root": "needed to restart the device",
    "unboxed": "needed to run the reboot command"
  },
  "options": [
    {
      "title": "manual restart",
      "type": "section"
    },
    {
      "title": "restart now (switch on to restart, switch off again afterwards)",
      "name": "restart_now",
      "type": "boolean",
      "default": false
    },
    {
      "title": "restart time per day (24h, hh:mm, leave empty for no restart)",
      "type": "section"
    },
    {
      "title": "monday",
      "name": "time_mon",
      "type": "string",
      "default": "04:00"
    },
    {
      "title": "tuesday",
      "name": "time_tue",
      "type": "string",
      "default": "04:00"
    },
    {
      "title": "wednesday",
      "name": "time_wed",
      "type": "string",
      "default": "04:00"
    },
    {
      "title": "thursday",
      "name": "time_thu",
      "type": "string",
      "default": "04:00"
    },
    {
      "title": "friday",
      "name": "time_fri",
      "type": "string",
      "default": "04:00"
    },
    {
      "title": "saturday",
      "name": "time_sat",
      "type": "string",
      "default": "04:00"
    },
    {
      "title": "sunday",
      "name": "time_sun",
      "type": "string",
      "default": "04:00"
    }
  ]
}
